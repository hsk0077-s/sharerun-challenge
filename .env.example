# Copy to .env and adjust for your machine. Never commit .env with real secrets.
# Local MVP defaults below — safe for emulator/mock testing only.

# --- Mode ---
LOCAL_DEV_MODE=true
USE_FIREBASE_EMULATOR=true
USE_LOCAL_MOCK_DATA=false
ALLOW_ANONYMOUS_BOOTSTRAP=true

# --- Firebase client (Flutter) ---
# Demo values work with Firebase Emulator; replace after flutterfire configure for prod.
FIREBASE_PROJECT_ID=demo-src-local
FIREBASE_API_KEY=demo-api-key
FIREBASE_APP_ID=1:demo-src-local:android:local000000
FIREBASE_MESSAGING_SENDER_ID=123456789012
# Android emulator -> 10.0.2.2 | iOS simulator / desktop -> 127.0.0.1
FIREBASE_EMULATOR_HOST=10.0.2.2
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_FIRESTORE_EMULATOR_PORT=8085

# --- Backend API (Flutter -> Cloud Run / local uvicorn) ---
# Debug (`flutter run`): leave empty for AppEnv loopback defaults.
#   Physical Android (adb reverse tcp:8080 tcp:8080): http://127.0.0.1:8080
#   iOS / desktop: http://127.0.0.1:8080
#   Android emulator: --dart-define=ANDROID_EMULATOR=true
#                     or JENA_BASE_URL=http://10.0.2.2:8080
# JENA_BASE_URL=http://127.0.0.1:8080
#
# Release / profile (`flutter build apk|ios` / `flutter run --release`):
# loopback is ignored so join/harvest are not debug-local-only. Set the
# public Cloud Run URL (not a secret) — do not commit real API keys:
#   JENA_BASE_URL=https://<src-jena-ai-hash>.asia-northeast3.run.app
#   JENA_CLOUD_RUN_BASE_URL=https://<src-jena-ai-hash>.asia-northeast3.run.app
# Lookup: gcloud run services describe src-jena-ai --region asia-northeast3 --format='value(status.url)'
# USE_FIREBASE_EMULATOR is ignored in release so ID tokens match Cloud Run.
# FIREBASE_* must be the same GCP project as Cloud Run, or ship
# android/app/google-services.json (gitignored).
PG_BASE_URL=https://pg.example.com

# Google Maps — required for live run map & Crew Map
# 1) Set GOOGLE_MAPS_API_KEY here (Dart UI gating via AppEnv.isGoogleMapsConfigured)
# 2) Android native: android/app/src/main/AndroidManifest.xml
#    <meta-data android:name="com.google.android.geo.API_KEY" android:value="YOUR_KEY"/>
# 3) iOS native: ios/Runner/AppDelegate.swift — GMSServices.provideAPIKey("YOUR_KEY")
#    or add GMSApiKey to ios/Runner/Info.plist
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_NATIVE_CONFIGURED=false

# --- Backend server (Python) ---
GOOGLE_CLOUD_PROJECT=demo-src-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PG_WEBHOOK_SECRET=dev-secret
OPS_ADMIN_SECRET=dev-ops-secret
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8080

# Debug 1M wallet grant. flutter run (kDebugMode) sends a baked debug-client
# secret automatically after login — no Firebase console / UID lookup needed.
# Release/profile store builds never send it. Optional overrides below.
TEST_WALLET_GRANT_UIDS=
TEST_WALLET_GRANT_SECRET=

GOOGLE_WEB_CLIENT_ID=
