# 구글 플레이에 올리는 출시용 앱 파일(AAB) 설정 견본. 이 파일을 .env.release 로 복사해 채운다.
# .env.release 는 git에 올라가지 않는다(.gitignore). 아래에는 앱이 실제로 읽는 이름만 있다.
#
#   flutter build appbundle --release --dart-define-from-file=.env.release
#
# 서버 전용 비밀(OPS_ADMIN_SECRET, PG_WEBHOOK_SECRET 등)은 앱에 필요 없으므로 넣지 않는다.
# 개발용 값(LOCAL_DEV_MODE=true, 에뮬레이터, 집 안 주소 등)도 넣지 않는다.

# 서버(Cloud Run) 주소. 비밀이 아니다. 출시 빌드에서는 집·사무실 안 주소와 127.0.0.1을 무시하고
# 아래 주소(또는 코드에 들어 있는 기본 주소)를 쓴다.
JENA_BASE_URL=https://src-jena-ai-1089697395275.asia-northeast3.run.app

# 구글 로그인용 웹 클라이언트 ID(비밀 아님). Firebase 콘솔 > 인증 > Google 의 웹 클라이언트 ID.
GOOGLE_WEB_CLIENT_ID=

# 네이버 로그인. 앱이 Dart로 읽지 않고, 이 파일을 dart-define으로 넘기면 Gradle이
# Android 매니페스트에 넣는다. 값은 네이버 개발자 콘솔 것을 로컬에만 적는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 앱 안 현금 결제는 1.0에서 끈다.
IN_APP_PURCHASES_ENABLED=false

# 개발용 켜짐 스위치는 모두 끈다.
LOCAL_DEV_MODE=false
USE_FIREBASE_EMULATOR=false

# 후원은 보류. 켜지 않는다.
SPONSORSHIP_ENABLED=false

# 1.0은 DIA 팩 판매가 없다. 판매를 시작하는 업데이트에서만 true로 바꾼다.
DIA_PACKS_ENABLED=false

# Firebase 설정(FIREBASE_PROJECT_ID, FIREBASE_API_KEY, FIREBASE_APP_ID, FIREBASE_MESSAGING_SENDER_ID)은
# 비워 두면 android/app/google-services.json 을 쓴다. 출시 빌드는 이 방식을 권한다.
