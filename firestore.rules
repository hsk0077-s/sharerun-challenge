rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyAllowedUserProfileFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'uid',
        'watchType',
        'watchTypeUpdatedAt',
        'sensitiveDataConsent',
        'sensitiveDataConsentUpdatedAt',
        'healthDataConsent',
        'healthDataConsentUpdatedAt',
        'updatedAt'
      ]);
    }

    function validTermsAcceptanceUpdate(uid) {
      return isOwner(uid)
        && resource.data.termsAccepted == false
        && request.resource.data.termsAccepted == true
        && request.resource.data.uid == uid
        && request.resource.data.pushNotificationsEnabled is bool
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'termsAccepted',
          'termsAcceptedAt',
          'pushNotificationsEnabled',
          'pushNotificationsUpdatedAt',
          'updatedAt'
        ]);
    }

    function validPushSettingsUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.pushNotificationsEnabled is bool
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'pushNotificationsEnabled',
          'pushNotificationsUpdatedAt',
          'fcmToken',
          'fcmTokenUpdatedAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['fcmToken'])
          || request.resource.data.fcmToken is string
        );
    }

    function validWatchType() {
      return request.resource.data.watchType in [
        'none',
        'apple_watch',
        'galaxy_watch',
        'garmin'
      ];
    }

    // Keep in sync with Flutter `PG_BASE_URL` / PaymentConstants.pgBaseUrl host.
    function pgHostPattern() {
      return 'pg\\.example\\.com';
    }

    function validShareTopUpPgUrl(url) {
      return url.matches('^https://' + pgHostPattern() + '/share-top-up\\?.+');
    }

    function validSponsorPgUrl(url) {
      return url.matches('^https://' + pgHostPattern() + '/sponsor\\?.+');
    }

    function validUserProfileUpdate(uid) {
      return isOwner(uid)
        && onlyAllowedUserProfileFields()
        && request.resource.data.uid == uid
        && validWatchType()
        && request.resource.data.sensitiveDataConsent is bool;
    }

    function validWatchApiTokenUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'watch_api_token',
          'watchApiToken',
          'watchLinkPendingType',
          'isDeviceConnected',
          'watchApiTokenUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.watch_api_token is string
        && request.resource.data.watchApiToken is string
        && request.resource.data.watchLinkPendingType in [
          'apple_watch',
          'galaxy_watch',
          'garmin',
          'coros',
          'suunto'
        ]
        && request.resource.data.isDeviceConnected == true;
    }

    function validUserSettingsUpdate(uid) {
      return validUserProfileUpdate(uid)
        || validTermsAcceptanceUpdate(uid)
        || validPushSettingsUpdate(uid)
        || validWatchApiTokenUpdate(uid)
        || validNonMoneyProfileUpdate(uid)
        || validOnboardingConsentsUpdate(uid)
        || validDeviceOnboardingUpdate(uid);
    }

    // Nickname / gender only — never wallet, share, or economy maps.
    function validNonMoneyProfileUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'nickname',
          'nicknameUpdatedAt',
          'nicknameSetAt',
          'gender',
          'genderUpdatedAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(['nickname'])
          || request.resource.data.nickname is string
        )
        && (
          !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(['gender'])
          || request.resource.data.gender in ['male', 'female']
        );
    }

    function validOnboardingConsentsUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'termsAccepted',
          'termsAcceptedAt',
          'sensitiveDataConsent',
          'sensitiveDataConsentUpdatedAt',
          'healthDataConsent',
          'healthDataConsentUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.termsAccepted is bool
        && request.resource.data.sensitiveDataConsent is bool;
    }

    function validDeviceOnboardingUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'isOnboardingCompleted',
          'isDeviceConnected',
          'connectedDeviceType',
          'watchType',
          'watchTypeUpdatedAt',
          'healthDataConsent',
          'healthDataConsentUpdatedAt',
          'sensitiveDataConsent',
          'sensitiveDataConsentUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.isOnboardingCompleted is bool
        && request.resource.data.isDeviceConnected is bool
        && validWatchType();
    }

    function validInitialWallet() {
      return request.resource.data.wallet is map
        && request.resource.data.wallet.keys().hasOnly([
          'shareBalance',
          'diamondBalance',
          'valueTokenBalance',
          'totalDonationValue'
        ])
        && request.resource.data.wallet.shareBalance == 0
        && request.resource.data.wallet.diamondBalance == 0
        && request.resource.data.wallet.valueTokenBalance == 0
        && request.resource.data.wallet.totalDonationValue == 0;
    }

    function resourceWalletBalancesEmpty() {
      return !('wallet' in resource.data)
        || (
          (
            !('shareBalance' in resource.data.wallet)
            || resource.data.wallet.shareBalance == 0
          )
          && (
            !('diamondBalance' in resource.data.wallet)
            || resource.data.wallet.diamondBalance == 0
          )
          && (
            !('valueTokenBalance' in resource.data.wallet)
            || resource.data.wallet.valueTokenBalance == 0
          )
        );
    }

    // Flutter `set(merge: true)` may apply `wallet.shareBalance` as a nested
    // field path (Android) or as a literal dotted key (some SDKs). Read either
    // so owner persist is not permission-denied.
    function incomingShare() {
      return request.resource.data.keys().hasAny(['wallet.shareBalance'])
        ? request.resource.data['wallet.shareBalance']
        : request.resource.data.wallet.shareBalance;
    }

    function incomingDiamond() {
      return request.resource.data.keys().hasAny(['wallet.diamondBalance'])
        ? request.resource.data['wallet.diamondBalance']
        : request.resource.data.wallet.diamondBalance;
    }

    function incomingValue() {
      return request.resource.data.keys().hasAny(['wallet.valueTokenBalance'])
        ? request.resource.data['wallet.valueTokenBalance']
        : request.resource.data.wallet.valueTokenBalance;
    }

    function resourceShare() {
      return 'wallet' in resource.data
        && 'shareBalance' in resource.data.wallet
        ? resource.data.wallet.shareBalance
        : 0;
    }

    function resourceDiamond() {
      return 'wallet' in resource.data
        && 'diamondBalance' in resource.data.wallet
        ? resource.data.wallet.diamondBalance
        : 0;
    }

    function resourceValue() {
      return 'wallet' in resource.data
        && 'valueTokenBalance' in resource.data.wallet
        ? resource.data.wallet.valueTokenBalance
        : 0;
    }

    // affectedKeys includes newly added dotted fields; changedKeys does not.
    function userAffectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Debug USB one-shot: empty wallet -> 1,000,000 SHARE/DIA/VALUE.
    // Release clients never call this. Re-apply is allowed only while still 0.
    function validDebugTestWalletGrant(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && resourceWalletBalancesEmpty()
        && request.resource.data.testGrant1mDone == true
        && incomingShare() == 1000000
        && incomingDiamond() == 1000000
        && incomingValue() == 1000000
        && userAffectedKeys().hasOnly([
          'uid',
          'wallet',
          'wallet.shareBalance',
          'wallet.diamondBalance',
          'wallet.valueTokenBalance',
          'testGrant1mDone',
          'updatedAt'
        ]);
    }

    // Debug harvest: SHARE may increase after the one-shot grant. DIA/VALUE
    // must stay unchanged. Release clients never call this path.
    function validDebugLocalHarvestShare(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && resource.data.testGrant1mDone == true
        && request.resource.data.testGrant1mDone == true
        && incomingShare() is int
        && incomingShare() >= resourceShare()
        && incomingDiamond() == resourceDiamond()
        && incomingValue() == resourceValue()
        && userAffectedKeys().hasOnly([
          'uid',
          'wallet',
          'wallet.shareBalance',
          'updatedAt'
        ]);
    }

    // Debug USB: SHARE may decrease after the one-shot grant (join / personal
    // sponsor). DIA/VALUE stay unchanged. Donation totals may only increase.
    // Release clients never call this path.
    function validDebugShareSpend(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && resource.data.testGrant1mDone == true
        && request.resource.data.testGrant1mDone == true
        && incomingShare() is int
        && incomingShare() >= 0
        && incomingShare() < resourceShare()
        && incomingDiamond() == resourceDiamond()
        && incomingValue() == resourceValue()
        && userAffectedKeys().hasOnly([
          'uid',
          'wallet',
          'wallet.shareBalance',
          'wallet.diamondBalance',
          'wallet.valueTokenBalance',
          'testGrant1mDone',
          'updatedAt',
          'donationCount',
          'cumulativeDonationAmount',
          'isSponsored'
        ])
        && (
          !userAffectedKeys().hasAny(['donationCount'])
          || (
            request.resource.data.donationCount is int
            && request.resource.data.donationCount >= (
              'donationCount' in resource.data
                ? resource.data.donationCount
                : 0
            )
          )
        )
        && (
          !userAffectedKeys().hasAny(['cumulativeDonationAmount'])
          || (
            request.resource.data.cumulativeDonationAmount is int
            && request.resource.data.cumulativeDonationAmount >= (
              'cumulativeDonationAmount' in resource.data
                ? resource.data.cumulativeDonationAmount
                : 0
            )
          )
        );
    }

    // Personal SHARE sponsor: increment donation count/total only.
    // Does not touch wallet SHARE/DIA/VALUE (those stay on the debit path).
    function validDonationRecord(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'uid',
              'donationCount',
              'cumulativeDonationAmount',
              'isSponsored',
              'angelTierCode',
              'updatedAt'
            ])
        && request.resource.data.donationCount is int
        && request.resource.data.donationCount >= (
          'donationCount' in resource.data
            ? resource.data.donationCount
            : 0
        )
        && request.resource.data.cumulativeDonationAmount is int
        && request.resource.data.cumulativeDonationAmount >= (
          'cumulativeDonationAmount' in resource.data
            ? resource.data.cumulativeDonationAmount
            : 0
        )
        && request.resource.data.isSponsored == true
        && (
          !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(['angelTierCode'])
          || request.resource.data.angelTierCode is string
        );
    }

    // Debug USB: shop DIA and/or VALUE may decrease after the one-shot
    // grant. SHARE must stay unchanged. hasCPR may only become true.
    // Release clients never call this path.
    function validDebugShopCurrencySpend(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && resource.data.testGrant1mDone == true
        && request.resource.data.testGrant1mDone == true
        && incomingShare() == resourceShare()
        && incomingDiamond() is int
        && incomingDiamond() >= 0
        && incomingValue() is int
        && incomingValue() >= 0
        && incomingDiamond() <= resourceDiamond()
        && incomingValue() <= resourceValue()
        && (
          incomingDiamond() < resourceDiamond()
          || incomingValue() < resourceValue()
        )
        && userAffectedKeys().hasOnly([
          'uid',
          'wallet',
          'wallet.shareBalance',
          'wallet.diamondBalance',
          'wallet.valueTokenBalance',
          'testGrant1mDone',
          'updatedAt',
          'hasCPR'
        ])
        && (
          !userAffectedKeys().hasAny(['hasCPR'])
          || request.resource.data.hasCPR == true
        );
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'watchType',
          'tier',
          'sensitiveDataConsent',
          'termsAccepted',
          'pushNotificationsEnabled',
          'wallet',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.watchType == 'none'
        && request.resource.data.tier == 1
        && request.resource.data.sensitiveDataConsent == false
        && request.resource.data.termsAccepted == false
        && request.resource.data.pushNotificationsEnabled == false
        && validInitialWallet();
    }

    // Client receipts: `users/{uid}/wallet_transactions` via
    // WalletRepository.logClientWalletTransaction. Optional uid must match
    // the signed-in owner. Amount may be negative (spend).
    function validClientWalletTransactionCreate() {
      return request.resource.data.keys().hasOnly([
          'id',
          'uid',
          'title',
          'amount',
          'assetType',
          'timestamp'
        ])
        && request.resource.data.id is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.amount is int
        && request.resource.data.assetType in ['SHARE', 'DIA', 'VALUE']
        && request.resource.data.timestamp is timestamp
        && (
          !('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid
        );
    }

    function validClientNotificationCreate() {
      return request.resource.data.keys().hasOnly([
          'title',
          'body',
          'code',
          'timestamp'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.body is string
        && request.resource.data.body.size() < 1000
        && request.resource.data.code is string
        && request.resource.data.timestamp is timestamp;
    }

    function validRetentionPushCreate() {
      return request.resource.data.keys().hasOnly([
          'code',
          'title',
          'body',
          'routeName',
          'extra',
          'delivered',
          'createdAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.delivered == false
        && request.resource.data.createdAt is timestamp;
    }

    function validShareTopUpIntentCreate() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'type',
          'amountKrw',
          'status',
          'pgUrl',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'share_top_up'
        && request.resource.data.amountKrw is int
        && request.resource.data.amountKrw == 10000
        && request.resource.data.status == 'created'
        && request.resource.data.pgUrl is string
        && validShareTopUpPgUrl(request.resource.data.pgUrl);
    }

    function validSponsorPaymentIntentCreate() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'sponsorId',
          'tournamentId',
          'type',
          'amountShare',
          'option',
          'status',
          'pgUrl',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sponsorId == request.auth.uid
        && request.resource.data.tournamentId is string
        && request.resource.data.type == 'sponsor_payment'
        && request.resource.data.amountShare is int
        && request.resource.data.amountShare in [1000, 3000, 5000]
        && request.resource.data.option in [
          'direct_prize_support',
          'winner_named_unicef_donation'
        ]
        && request.resource.data.status == 'created'
        && request.resource.data.pgUrl is string
        && validSponsorPgUrl(request.resource.data.pgUrl);
    }

    function isOwnPaymentCreate() {
      return signedIn()
        && (
          validShareTopUpIntentCreate()
          || validSponsorPaymentIntentCreate()
        );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email in [
          'admin@share-run-challenge.app',
          'ops@share-run-challenge.app'
        ]
      );
    }

    // SRC Admin console — status / VALUE 핀셋 갱신만 허용
    function isAdminUserOpsUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminStatus', 'wallet', 'updatedAt']);
    }

    // Crew tab create («새 크루 창설하기»).
    // Keep 50000 in sync with CrewFoundingWrite.shareCost.
    // Deploy these rules or that transaction stays PERMISSION_DENIED.
    //
    // Do not use incomingShare()/incomingDiamond()/incomingValue() here.
    // Those helpers prefer a literal top-level key named "wallet.shareBalance"
    // (Flutter set(merge) dotted keys). Crew founding uses Transaction.update,
    // which changes the nested map only. A stale literal key then fails the
    // 50,000 debit check and the user update walks the rest of `allow update`
    // until the 1000-expression cap, which the client shows as permission-denied.
    function validCrewFoundingDebit(uid) {
      return isOwner(uid)
        && 'ownedCrewId' in request.resource.data
        && request.resource.data.ownedCrewId is string
        && request.resource.data.ownedCrewId.matches('^[A-Za-z0-9]{20}$')
        && userAffectedKeys().hasAll(['ownedCrewId'])
        && userAffectedKeys().hasOnly([
          'wallet',
          'wallet.shareBalance',
          'ownedCrewId',
          'updatedAt'
        ])
        && 'wallet' in request.resource.data
        && request.resource.data.wallet is map
        && request.resource.data.wallet.shareBalance is int
        && resourceShare() is int
        && request.resource.data.wallet.shareBalance >= 0
        && request.resource.data.wallet.shareBalance == resourceShare() - 50000
        && (
          !('wallet' in resource.data)
          || !(resource.data.wallet is map)
          || !('diamondBalance' in resource.data.wallet)
          || request.resource.data.wallet.diamondBalance
              == resource.data.wallet.diamondBalance
        )
        && (
          !('wallet' in resource.data)
          || !(resource.data.wallet is map)
          || !('valueTokenBalance' in resource.data.wallet)
          || request.resource.data.wallet.valueTokenBalance
              == resource.data.wallet.valueTokenBalance
        )
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/crews/$(request.resource.data.ownedCrewId))
        && existsAfter(/databases/$(database)/documents/crews/$(request.resource.data.ownedCrewId))
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.ownedCrewId)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.ownedCrewId)).data.shareCost == 50000
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.ownedCrewId)).data.memberCount == 1
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.ownedCrewId)).data.totalValue == 0;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if validUserCreate(uid);
      // Clients cannot set testGrant1mEligible. testGrant1mDone is only
      // writable via the one-shot empty-wallet debug grant below.
      // Owner wallet persist (grant / harvest / SHARE spend / shop DIA-VALUE)
      // is the helpers below — deploy this file or those writes stay
      // PERMISSION_DENIED even though local #34 persist works.
      // Crew founding is first so a matching create does not walk the
      // large debug-spend helpers (expression budget). Non-crew updates
      // fail the ownedCrewId guard and continue as before.
      allow update: if validCrewFoundingDebit(uid)
        || isAdminUserOpsUpdate()
        || validDebugTestWalletGrant(uid)
        || validDebugLocalHarvestShare(uid)
        || validDebugShareSpend(uid)
        || validDonationRecord(uid)
        || validDebugShopCurrencySpend(uid)
        || (
          validUserSettingsUpdate(uid)
          && !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'testGrant1mEligible',
            'testGrant1mDone'
          ])
        );
      allow delete: if false;

      match /collectedDiamondBoxes/{boxId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Owner read of the shop purchase inventory. Admin SDK writes the
      // quantity in the purchase transaction. Clients must not mint items.
      // Deploy with: firebase deploy --only firestore:rules
      match /shopInventory/{itemId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Owner-only per-account day. steps is an int in 0..30000.
      // A positive day cannot be replaced by 0. A lower total is allowed
      // only when lastHealth backs a heal (today's Health + 2,000 lead).
      // Deploy with: firebase deploy --only firestore:rules
      match /daily_metrics/{dayKey} {
        function validDailyMetric() {
          let keys = request.resource.data.keys();
          return keys.hasAll(['steps', 'updatedAt'])
            && keys.hasOnly([
              'steps',
              'km',
              'updatedAt',
              'source',
              'lastHealth',
              'deviceId',
              'deviceModel'
            ])
            && request.resource.data.steps is int
            && request.resource.data.steps >= 0
            && request.resource.data.steps <= 30000
            && (
              !keys.hasAny(['source'])
              || request.resource.data.source in ['health_connect', 'sensor']
            )
            && (
              !keys.hasAny(['lastHealth'])
              || (
                request.resource.data.lastHealth is int
                && request.resource.data.lastHealth > 0
                && request.resource.data.lastHealth <= 30000
              )
            )
            && (
              !keys.hasAny(['km'])
              || request.resource.data.km is number
            )
            && (
              !keys.hasAny(['deviceId'])
              || (
                request.resource.data.deviceId is string
                && request.resource.data.deviceId.size() <= 64
              )
            )
            && (
              !keys.hasAny(['deviceModel'])
              || (
                request.resource.data.deviceModel is string
                && request.resource.data.deviceModel.size() <= 64
              )
            );
        }

        function dailyMetricNotClobbered() {
          return !exists(/databases/$(database)/documents/users/$(uid)/daily_metrics/$(dayKey))
            || !('steps' in resource.data)
            || !(resource.data.steps is int)
            || request.resource.data.steps >= resource.data.steps
            || (
              request.resource.data.steps > 0
              && request.resource.data.keys().hasAny(['lastHealth'])
              && request.resource.data.lastHealth is int
              && request.resource.data.lastHealth > 0
              && request.resource.data.steps
                <= request.resource.data.lastHealth + 2000
            );
        }

        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validDailyMetric()
          && dailyMetricNotClobbered();
        allow delete: if false;
      }

      // Owner-only payment/spend receipts. Deploy this match or History
      // create is PERMISSION_DENIED for the signed-in user.
      match /wallet_transactions/{txId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validClientWalletTransactionCreate();
        allow update, delete: if false;
      }

      match /notifications/{noticeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validClientNotificationCreate();
        allow update, delete: if false;
      }

      match /retentionPushes/{pushId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validRetentionPushCreate();
        allow update, delete: if false;
      }
    }

    function isOwnWatchLinkHandoff(activityId) {
      return signedIn()
        && activityId == ('watch-link-' + request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'watch_api_token',
          'watchApiToken',
          'watchType',
          'jenaPipelineReady',
          'updatedAt'
        ])
        && request.resource.data.watch_api_token is string
        && request.resource.data.watchType in [
          'apple_watch',
          'galaxy_watch',
          'garmin',
          'coros',
          'suunto'
        ]
        && request.resource.data.jenaPipelineReady == true;
    }

    match /appeals/{appealId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.activityId is string
        && request.resource.data.proofImageUri is string
        && request.resource.data.status == 'under_review'
        && request.resource.data.ttlDays == 14;
      allow update, delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isOwnWatchLinkHandoff(activityId);
      allow delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /participants/{uid} {
        allow read: if signedIn() || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /diamondBoxes/{boxId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Official catalogs. Clients read; admin replaces the doc.
    // company_tournament is the prize-race config (Jena also serves it).
    match /config/{docId} {
      allow read: if (signedIn() || isAdmin())
        && (docId == 'stamp_tour' || docId == 'company_tournament');
      allow write: if isAdmin()
        && (docId == 'stamp_tour' || docId == 'company_tournament');
    }

    match /stampLandmarks/{landmarkId} {
      allow read: if signedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // Created only with validCrewFoundingDebit in the same transaction.
    match /crews/{crewId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create: if signedIn()
        && crewId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly([
          'name',
          'ownerUid',
          'totalValue',
          'memberCount',
          'shareCost',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.totalValue == 0
        && request.resource.data.memberCount == 1
        && request.resource.data.shareCost == 50000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownedCrewId == crewId;
      allow update, delete: if false;
    }

    match /crewRankings/{crewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /paymentIntents/{intentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isOwnPaymentCreate();
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING_VERIFY'
        && request.resource.data.productId is string
        && request.resource.data.purchaseID is string;
      allow update, delete: if isAdmin();
    }

    match /walletTransactions/{txId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Invite-code index. Minted only by the secured API (Admin SDK).
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Referral SHARE payout markers. Clients cannot create or delete these,
    // and cannot credit wallet.shareBalance on this path.
    match /referralPayouts/{payoutId} {
      allow read, write: if false;
    }

    // Jena admin API writes these with the Admin SDK. Clients cannot.
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
