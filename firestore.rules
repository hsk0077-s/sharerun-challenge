rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyAllowedUserProfileFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'uid',
        'watchType',
        'watchTypeUpdatedAt',
        'sensitiveDataConsent',
        'sensitiveDataConsentUpdatedAt',
        'healthDataConsent',
        'healthDataConsentUpdatedAt',
        'updatedAt'
      ]);
    }

    function validTermsAcceptanceUpdate(uid) {
      return isOwner(uid)
        && resource.data.termsAccepted == false
        && request.resource.data.termsAccepted == true
        && request.resource.data.uid == uid
        && request.resource.data.pushNotificationsEnabled is bool
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'termsAccepted',
          'termsAcceptedAt',
          'pushNotificationsEnabled',
          'pushNotificationsUpdatedAt',
          'updatedAt'
        ]);
    }

    function validPushSettingsUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.pushNotificationsEnabled is bool
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'pushNotificationsEnabled',
          'pushNotificationsUpdatedAt',
          'fcmToken',
          'fcmTokenUpdatedAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['fcmToken'])
          || request.resource.data.fcmToken is string
        );
    }

    function validWatchType() {
      return request.resource.data.watchType in [
        'none',
        'apple_watch',
        'galaxy_watch',
        'garmin'
      ];
    }

    // Keep in sync with Flutter `PG_BASE_URL` / PaymentConstants.pgBaseUrl host.
    function pgHostPattern() {
      return 'pg\\.example\\.com';
    }

    function validShareTopUpPgUrl(url) {
      return url.matches('^https://' + pgHostPattern() + '/share-top-up\\?.+');
    }

    function validSponsorPgUrl(url) {
      return url.matches('^https://' + pgHostPattern() + '/sponsor\\?.+');
    }

    function validUserProfileUpdate(uid) {
      return isOwner(uid)
        && onlyAllowedUserProfileFields()
        && request.resource.data.uid == uid
        && validWatchType()
        && request.resource.data.sensitiveDataConsent is bool;
    }

    function validWatchApiTokenUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'watch_api_token',
          'watchApiToken',
          'watchLinkPendingType',
          'isDeviceConnected',
          'watchApiTokenUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.watch_api_token is string
        && request.resource.data.watchApiToken is string
        && request.resource.data.watchLinkPendingType in [
          'apple_watch',
          'galaxy_watch',
          'garmin',
          'coros',
          'suunto'
        ]
        && request.resource.data.isDeviceConnected == true;
    }

    function validUserSettingsUpdate(uid) {
      return validUserProfileUpdate(uid)
        || validTermsAcceptanceUpdate(uid)
        || validPushSettingsUpdate(uid)
        || validWatchApiTokenUpdate(uid)
        || validNonMoneyProfileUpdate(uid)
        || validOnboardingConsentsUpdate(uid)
        || validDeviceOnboardingUpdate(uid);
    }

    // Nickname / gender only — never wallet, share, or economy maps.
    function validNonMoneyProfileUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'nickname',
          'nicknameUpdatedAt',
          'nicknameSetAt',
          'gender',
          'genderUpdatedAt',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(['nickname'])
          || request.resource.data.nickname is string
        )
        && (
          !request.resource.data.diff(resource.data).changedKeys()
              .hasAny(['gender'])
          || request.resource.data.gender in ['male', 'female']
        );
    }

    function validOnboardingConsentsUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'termsAccepted',
          'termsAcceptedAt',
          'sensitiveDataConsent',
          'sensitiveDataConsentUpdatedAt',
          'healthDataConsent',
          'healthDataConsentUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.termsAccepted is bool
        && request.resource.data.sensitiveDataConsent is bool;
    }

    function validDeviceOnboardingUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'uid',
          'isOnboardingCompleted',
          'isDeviceConnected',
          'connectedDeviceType',
          'watchType',
          'watchTypeUpdatedAt',
          'healthDataConsent',
          'healthDataConsentUpdatedAt',
          'sensitiveDataConsent',
          'sensitiveDataConsentUpdatedAt',
          'updatedAt'
        ])
        && request.resource.data.isOnboardingCompleted is bool
        && request.resource.data.isDeviceConnected is bool
        && validWatchType();
    }

    function validInitialWallet() {
      return request.resource.data.wallet is map
        && request.resource.data.wallet.keys().hasOnly([
          'shareBalance',
          'diamondBalance',
          'valueTokenBalance',
          'totalDonationValue'
        ])
        && request.resource.data.wallet.shareBalance == 0
        && request.resource.data.wallet.diamondBalance == 0
        && request.resource.data.wallet.valueTokenBalance == 0
        && request.resource.data.wallet.totalDonationValue == 0;
    }

    function userAffectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Balances, grant flags, donation totals, and shop entitlements.
    // Only the Admin SDK may write these. Signup may still create a zero wallet.
    function clientCurrencyAffected() {
      return userAffectedKeys().hasAny([
        'wallet',
        'wallet.shareBalance',
        'wallet.diamondBalance',
        'wallet.valueTokenBalance',
        'wallet.totalDonationValue',
        'shareBalance',
        'diamondBalance',
        'valueBalance',
        'valueTokenBalance',
        'testGrant1mDone',
        'testGrant1mEligible',
        'donationCount',
        'cumulativeDonationAmount',
        'totalDonationValue',
        'hasCPR',
        'angelTierCode',
        'isSponsored'
      ]);
    }

    function validUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'watchType',
          'tier',
          'sensitiveDataConsent',
          'termsAccepted',
          'pushNotificationsEnabled',
          'wallet',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.watchType == 'none'
        && request.resource.data.tier == 1
        && request.resource.data.sensitiveDataConsent == false
        && request.resource.data.termsAccepted == false
        && request.resource.data.pushNotificationsEnabled == false
        && validInitialWallet();
    }

    function validClientNotificationCreate() {
      return request.resource.data.keys().hasOnly([
          'title',
          'body',
          'code',
          'timestamp'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.body is string
        && request.resource.data.body.size() < 1000
        && request.resource.data.code is string
        && request.resource.data.timestamp is timestamp;
    }

    function validRetentionPushCreate() {
      return request.resource.data.keys().hasOnly([
          'code',
          'title',
          'body',
          'routeName',
          'extra',
          'delivered',
          'createdAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.delivered == false
        && request.resource.data.createdAt is timestamp;
    }

    function validShareTopUpIntentCreate() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'type',
          'amountKrw',
          'status',
          'pgUrl',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'share_top_up'
        && request.resource.data.amountKrw is int
        && request.resource.data.amountKrw == 10000
        && request.resource.data.status == 'created'
        && request.resource.data.pgUrl is string
        && validShareTopUpPgUrl(request.resource.data.pgUrl);
    }

    function validSponsorPaymentIntentCreate() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'sponsorId',
          'tournamentId',
          'type',
          'amountShare',
          'option',
          'status',
          'pgUrl',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sponsorId == request.auth.uid
        && request.resource.data.tournamentId is string
        && request.resource.data.type == 'sponsor_payment'
        && request.resource.data.amountShare is int
        && request.resource.data.amountShare in [1000, 3000, 5000]
        && request.resource.data.option in [
          'direct_prize_support',
          'winner_named_unicef_donation'
        ]
        && request.resource.data.status == 'created'
        && request.resource.data.pgUrl is string
        && validSponsorPgUrl(request.resource.data.pgUrl);
    }

    function isOwnPaymentCreate() {
      return signedIn()
        && (
          validShareTopUpIntentCreate()
          || validSponsorPaymentIntentCreate()
        );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email in [
          'admin@share-run-challenge.app',
          'ops@share-run-challenge.app'
        ]
      );
    }

    // Admin console status only. Wallet fields stay on the Admin SDK.
    function isAdminUserOpsUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminStatus', 'updatedAt']);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if validUserCreate(uid);
      // Profile/settings only. Balances and grant flags stay server-owned.
      allow update: if isAdminUserOpsUpdate()
        || (
          validUserSettingsUpdate(uid)
          && !clientCurrencyAffected()
        );
      allow delete: if false;

      match /collectedDiamondBoxes/{boxId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Owner read of the shop purchase inventory. Admin SDK writes the
      // quantity in the purchase transaction. Clients must not mint items.
      // Deploy with: firebase deploy --only firestore:rules
      match /shopInventory/{itemId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Owner-only per-account day. steps is an int in 0..30000.
      // A positive day cannot be replaced by 0. A lower total is allowed
      // only when lastHealth backs a heal (today's Health + 2,000 lead).
      // Deploy with: firebase deploy --only firestore:rules
      match /daily_metrics/{dayKey} {
        function validDailyMetric() {
          let keys = request.resource.data.keys();
          return keys.hasAll(['steps', 'updatedAt'])
            && keys.hasOnly([
              'steps',
              'km',
              'updatedAt',
              'source',
              'lastHealth',
              'deviceId',
              'deviceModel',
              'streakCovered',
              'coveredAt',
              'coveredByRequestId',
              'streakPaused',
              'pausedAt',
              'pausedByRequestId'
            ])
            && request.resource.data.steps is int
            && request.resource.data.steps >= 0
            && request.resource.data.steps <= 30000
            && (
              !keys.hasAny(['source'])
              || request.resource.data.source in ['health_connect', 'sensor']
            )
            && (
              !keys.hasAny(['lastHealth'])
              || (
                request.resource.data.lastHealth is int
                && request.resource.data.lastHealth > 0
                && request.resource.data.lastHealth <= 30000
              )
            )
            && (
              !keys.hasAny(['km'])
              || request.resource.data.km is number
            )
            && (
              !keys.hasAny(['deviceId'])
              || (
                request.resource.data.deviceId is string
                && request.resource.data.deviceId.size() <= 64
              )
            )
            && (
              !keys.hasAny(['deviceModel'])
              || (
                request.resource.data.deviceModel is string
                && request.resource.data.deviceModel.size() <= 64
              )
            );
        }

        // Server streak marks stay. A phone cannot add, edit, or erase them.
        function serverFieldUnchanged(field, existed) {
          return (!existed && !(field in request.resource.data))
            || (existed
              && (field in resource.data) == (field in request.resource.data)
              && (!(field in resource.data)
                || request.resource.data[field] == resource.data[field]));
        }

        function streakServerFieldsKept() {
          let existed = exists(/databases/$(database)/documents/users/$(uid)/daily_metrics/$(dayKey));
          return serverFieldUnchanged('streakCovered', existed)
            && serverFieldUnchanged('coveredAt', existed)
            && serverFieldUnchanged('coveredByRequestId', existed)
            && serverFieldUnchanged('streakPaused', existed)
            && serverFieldUnchanged('pausedAt', existed)
            && serverFieldUnchanged('pausedByRequestId', existed);
        }

        function dailyMetricNotClobbered() {
          return !exists(/databases/$(database)/documents/users/$(uid)/daily_metrics/$(dayKey))
            || !('steps' in resource.data)
            || !(resource.data.steps is int)
            || request.resource.data.steps >= resource.data.steps
            || (
              request.resource.data.steps > 0
              && request.resource.data.keys().hasAny(['lastHealth'])
              && request.resource.data.lastHealth is int
              && request.resource.data.lastHealth > 0
              && request.resource.data.steps
                <= request.resource.data.lastHealth + 2000
            );
        }

        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validDailyMetric()
          && dailyMetricNotClobbered()
          && streakServerFieldsKept();
        allow delete: if false;
      }

      // Receipts are the server ledger `walletTransactions`. Clients read only.
      match /wallet_transactions/{txId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /notifications/{noticeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validClientNotificationCreate();
        allow update, delete: if false;
      }

      match /retentionPushes/{pushId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validRetentionPushCreate();
        allow update, delete: if false;
      }
    }

    function isOwnWatchLinkHandoff(activityId) {
      return signedIn()
        && activityId == ('watch-link-' + request.auth.uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'watch_api_token',
          'watchApiToken',
          'watchType',
          'jenaPipelineReady',
          'updatedAt'
        ])
        && request.resource.data.watch_api_token is string
        && request.resource.data.watchType in [
          'apple_watch',
          'galaxy_watch',
          'garmin',
          'coros',
          'suunto'
        ]
        && request.resource.data.jenaPipelineReady == true;
    }

    match /appeals/{appealId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.activityId is string
        && request.resource.data.proofImageUri is string
        && request.resource.data.status == 'under_review'
        && request.resource.data.ttlDays == 14;
      allow update, delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isOwnWatchLinkHandoff(activityId);
      allow delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /participants/{uid} {
        allow read: if signedIn() || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /diamondBoxes/{boxId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Official catalogs. Clients read the docs the app uses.
    // Admin SDK writes config; the client cannot.
    match /config/{docId} {
      allow read: if (signedIn() || isAdmin())
        && (docId == 'stamp_tour' || docId == 'company_tournament');
      allow write: if false;
    }

    match /stampLandmarks/{landmarkId} {
      allow read: if signedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // Crew docs are created by POST /actions/crew/found (Admin SDK).
    match /crews/{crewId} {
      allow get: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /crewRankings/{crewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /paymentIntents/{intentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isOwnPaymentCreate();
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING_VERIFY'
        && request.resource.data.productId is string
        && request.resource.data.purchaseID is string;
      allow update, delete: if isAdmin();
    }

    match /walletTransactions/{txId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Company donation matches. Admin SDK appends. The owner reads their row.
    match /donationLedger/{entryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Monthly company match pool. Admin SDK only.
    match /donationPools/{poolId} {
      allow read, write: if false;
    }

    // Invite-code index. Minted only by the secured API (Admin SDK).
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Referral SHARE payout markers. Clients cannot create or delete these,
    // and cannot credit wallet.shareBalance on this path.
    match /referralPayouts/{payoutId} {
      allow read, write: if false;
    }

    // Jena admin API writes these with the Admin SDK. Clients cannot.
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
