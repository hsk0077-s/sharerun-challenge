rules_version = '2';

// Walking Challenge brag card. One public PNG per user per day.
//   share_cards/{uid}/{yyyy-mm-dd}.png
// Only the owner writes (PNG, at most 5 MB). Anyone with the link can read:
// KakaoTalk fetches the image without signing in. Everything else is closed.
service firebase.storage {
  match /b/{bucket}/o {
    match /share_cards/{uid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/png'
        && file.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}\\.png');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
